# =============================================================================
# Environment configuration for Agentic Quant Sandbox
# =============================================================================
# Copy this file to .env and fill in the values.

# --- LLM Providers (at least one required) ------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Market Data --------------------------------------------------------------
POLYGON_API_KEY=polygon_api_key_for_real_time_data
ALPACA_API_KEY=alpaca_api_key_for_trading
ALPACA_SECRET_KEY=alpaca_secret_key

# --- Infrastructure -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
MONGO_URI=mongodb://localhost:27017/quant_sandbox
MONGODB_URI=mongodb://localhost:27017

# --- Application --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console   # console | json
MAX_RETRIES=3
REQUEST_TIMEOUT_SEC=30

# --- Risk Defaults (overridable at runtime) -----------------------------------
MAX_POSITION_PCT=0.20
MAX_DRAWDOWN_PCT=0.25
MAX_VAR_1D=0.02
MAX_CORRELATION=0.85
KELLY_CAP=0.25
MIN_TRADE_COUNT=20

# --- Execution Sandbox --------------------------------------------------------
# Maximum wall-clock seconds a generated strategy subprocess may run before
# it is killed. Lower values are safer in production; raise during debugging.
EXECUTOR_TIMEOUT_SECONDS=30
